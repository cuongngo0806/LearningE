# Copy this file to `.env` (same folder) and edit. Never commit your real .env.

# Port the app listens on.
PORT=8787

# AI endpoint. Leave blank to run fully offline (limited built-in content).
# Point this at your local Claude-compatible proxy:
AI_BASE_URL=http://localhost:20128/v1
AI_MODEL=dsa
# AI_API_KEY=local

# --- Sync your progress across machines (git) ---
# Point this at THIS repository's folder on this machine.
SYNC_REPO_DIR=C:/path/to/this/repo
SYNC_FILE=english-learning-data.json
SYNC_BRANCH=main
SYNC_REMOTE=origin
