# This repository ships the RUNNABLE APP + your learning data — not the source
# code. Everything is ignored by default; only the paths below are tracked.
/*

!.gitignore
!README.md
!app/
!english-learning-data.json

# The Obsidian vault projection (derived from the data, synced with it)
!english-vault/

# ...but not Obsidian's per-machine state, which would churn and conflict
english-vault/.obsidian/workspace.json
english-vault/.obsidian/workspace-mobile.json
english-vault/.obsidian/cache/

# Never commit real config (endpoints, keys, machine paths)
app/.env
